# Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_USER=smartclass
DB_PASSWORD=password123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartclass_db

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# JWT CONFIGURATION (Change in production!)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# TWILIO SMS CONFIGURATION (Optional)
# ============================================
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# AI MICROSERVICE (FastAPI face recognition / headcount service)
# ============================================
FASTAPI_URL=http://localhost:8000

# ============================================
# MOODLE LMS INTEGRATION (Optional)
# ============================================
MOODLE_URL=http://localhost/moodle/webservice/rest/server.php
MOODLE_TOKEN=your_moodle_webservice_token_here

# ============================================
# QR ATTENDANCE
# ============================================
QR_EXPIRY_MINUTES=15

# ============================================
# NOTES
# ============================================
# When using Docker: DB_HOST should be "database" (the service name)
# When running locally: DB_HOST should be "localhost"
