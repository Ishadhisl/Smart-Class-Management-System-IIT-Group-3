# Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# THIRD-PARTY SERVICES USED BY THIS APP (summary)
# ============================================
# WhatsApp        - utils/whatsappService.js, via @whiskeysockets/baileys. This is NOT a
#                   paid API and needs NO api key/env var here - Baileys drives a real
#                   WhatsApp Web session (scan the QR from Admin -> Communication Center
#                   once; WHATSAPP_SESSION_DIR below just controls where that login is
#                   saved so you don't have to rescan it after every restart).
# Payments        - Stripe (STRIPE_SECRET_KEY below). Bank-slip upload/manual verification
#                   is the other payment path and needs no external service at all.
# Photo/file host - Local disk (./uploads folder), backed by a persistent disk in production.
# Exam marks      - Google Sheets API (GOOGLE_API_KEY below) - optional "pull marks from a
#                   Google Sheet" feature only; manual Excel upload needs no key.
# LMS             - Moodle web services (MOODLE_URL/MOODLE_TOKEN below) - a Moodle instance
#                   you run/host yourself (local XAMPP or MoodleCloud), not a SaaS API key.
# None of the above are required to run the app - every integration degrades gracefully
# (logs a warning, disables that one feature) when its env var is left unset.

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Option A: single connection string (Neon, Render Postgres, Supabase, etc.)
# When set, this takes priority over the DB_* vars below and SSL is enabled automatically.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Option B: discrete vars (used when DATABASE_URL is not set — typical for local dev)
DB_USER=smartclass
DB_PASSWORD=password123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartclass_db
# Set to "true" if using Option B against a cloud DB that requires SSL
DB_SSL=false

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# JWT CONFIGURATION (Change in production!)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# How long a login session stays valid. Format: <number><s|m|h|d> (e.g. 30m, 12h, 1d).
JWT_EXPIRY=1d

# ============================================
# FRONTEND URL (required in production)
# Must exactly match the frontend's origin (no trailing slash) - used for CORS.
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# AI MICROSERVICE (FastAPI face recognition / headcount service)
# ============================================
FASTAPI_URL=http://localhost:8000
# dlib/YOLO need >=2GB RAM to even start without OOM-killing the whole backend container
# (not just the AI process). Set to "false" while running on a low-memory / free-tier
# instance to keep the rest of the app (login, WhatsApp, everything) stable; the AI panel
# will just report "unavailable" instead. Leave unset/true once you have enough RAM.
# AI_SERVER_ENABLED=true

# ============================================
# STRIPE (online payments)
# ============================================
# STRIPE_SECRET_KEY=sk_test_...

# ============================================
# GOOGLE SHEETS API (Exams: "pull marks from Google Sheet" feature)
# ============================================
# GOOGLE_API_KEY=your_google_sheets_api_key_here

# ============================================
# QR ATTENDANCE
# ============================================
QR_EXPIRY_MINUTES=15
# Public base URL for the QR verification link. Falls back to FRONTEND_URL if unset - only
# set this separately if the QR link needs to point somewhere different from the main
# frontend (e.g. a LAN IP so phones on the same network can scan it).
# PUBLIC_APP_URL=

# ============================================
# DEMO USERS
# Opt-in only. When SEED_DEMO_USERS=true, on boot the server ensures the four demo
# accounts (admin/counter/teacher/student) exist with role default passwords
# (Admin@123 / Counter@123 / Teacher@123 / Student@123). Off by default because on a
# free-tier host this ran on every restart, silently recreating deleted demo accounts
# even after real production users existed. Turn on for a fresh demo/viva environment.
# ============================================
# SEED_DEMO_USERS=false
# Only takes effect when SEED_DEMO_USERS=true. Also force-resets those 4 accounts back
# to the defaults (wipes any Forgot-Password change) for one deploy.
# RESET_DEMO_PASSWORDS=false

# ============================================
# WHATSAPP SESSION (Baileys auth keys)
# Default is a local ./whatsapp-session folder. On a host with an ephemeral filesystem,
# set this to a path INSIDE your persistent disk mount so the phone is linked only once.
# e.g. WHATSAPP_SESSION_DIR=/app/thusitha-backend/uploads/.wa-session
# ============================================
# WHATSAPP_SESSION_DIR=

# ============================================
# MOODLE LMS INTEGRATION (Optional)
# ============================================
MOODLE_URL=http://localhost/moodle/webservice/rest/server.php
MOODLE_TOKEN=your_moodle_webservice_token_here
# Role id of "SCMS Material Uploader" (Counter Person: upload materials only).
# Local XAMPP: node scripts/moodle_create_uploader_role.js prints it. Hosted Moodle: create the
# role by hand (see that script's header) and copy its id from Site admin → Define roles.
MOODLE_UPLOADER_ROLE_ID=

# ============================================
# NOTES
# ============================================
# When using Docker: DB_HOST should be "database" (the service name)
# When running locally: DB_HOST should be "localhost"
